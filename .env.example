# Wajib: API key DashScope / Model Studio Alibaba Cloud
# Tiongkok : https://bailian.console.aliyun.com/
# Global   : https://modelstudio.console.alibabacloud.com/
DASHSCOPE_API_KEY=

# Wajib untuk model qwen-audio-3.0-tts-plus (endpoint maas): Workspace ID
# Lihat konsol Model Studio → ikon di pojok kanan atas → Workspace ID (format: id-xxxxxxxx)
DASHSCOPE_WORKSPACE_ID=

# Opsional: region default, "cn" atau "intl" (bisa juga dipilih di UI)
DASHSCOPE_REGION=cn

# Opsional: password akses situs. Kosongkan = tanpa proteksi.
APP_ACCESS_PASSWORD=
